# PostgreSQL (Supabase). Project Settings > Database
# Cadena con pooler (transaction pooler, puerto 6543) para el runtime
DATABASE_URL="postgresql://postgres.REFERENCIA:TU-PASSWORD@aws-0-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión directa "Session pooler / direct" (puerto 5432). La usa Prisma Migrate.
# Si el host directo no resuelve DNS, copiá las cadenas actuales del dashboard de Supabase.
DIRECT_URL="postgresql://postgres:TU-PASSWORD@db.REFERENCIA.supabase.com:5432/postgres"

# Supabase Auth (Project Settings > API). "SUPABASE_URL" es el URL del proyecto
SUPABASE_URL="https://TU-PROYECTO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key"
# No lo usa el backend actualmente, puede quedar vacío
SUPABASE_JWT_SECRET=""

# Puerto del servidor. Render lo inyecta automáticamente en producción
PORT=4000
# Origen permitido por CORS. En producción: URL del frontend (ej: https://cauce.vercel.app)
FRONTEND_ORIGIN="http://localhost:5173"